{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag"
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "overrides": [
    {
      "files": [
        "src/app/**",
        "tests/app/**"
      ],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    ".mastra/**",
    "dist/**",
    "src/mastra/public/**",
    "skills/**",
    ".agents/**",
    ".claude/**",
    "qa/**"
  ]
}
