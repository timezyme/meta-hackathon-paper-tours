{
  "name": "amuseme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "10.33.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm build && AMUSEME_APP_DIR=src/mastra/public/app MASTRA_STUDIO_PATH=.mastra/output/studio MASTRA_TELEMETRY_DISABLED=true MASTRA_AGENT_SIGNALS=false node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/server/main.ts",
    "dev:app": "vite build --watch",
    "build:app": "vite build",
    "build": "pnpm build:app && MASTRA_TELEMETRY_DISABLED=true mastra build --studio && pnpm build:server",
    "start": "MASTRA_STUDIO_PATH=.mastra/output/studio MASTRA_TELEMETRY_DISABLED=true MASTRA_AGENT_SIGNALS=false node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/app/tsconfig.json",
    "lint": "oxlint --deny-warnings src tests scripts *.ts",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "prepare": "effect-tsgo patch",
    "build:server": "vite build --config vite.server.config.ts",
    "provision:user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-user.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "2.0.5",
    "@effect/platform-node": "4.0.3",
    "@hono/node-server": "1.19.17",
    "@libsql/client": "0.18.0",
    "@libsql/kysely-libsql": "0.4.1",
    "@mastra/core": "1.79.0",
    "@mastra/deployer": "1.79.0",
    "@mastra/libsql": "1.27.0",
    "@mastra/observability": "1.21.0",
    "better-auth": "1.7.7",
    "effect": "4.0.3",
    "hono": "4.13.14",
    "katex": "0.16.47",
    "kysely": "0.29.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zip-stream": "7.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.0",
    "@effect/vitest": "4.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/zip-stream": "7.0.0",
    "mastra": "1.35.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
