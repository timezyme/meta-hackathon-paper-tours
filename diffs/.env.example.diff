diff --git a/.env.example b/.env.example
--- a/.env.example
+++ b/.env.example
@@ -1,6 +1,10 @@
 AMUSEME_PORT=4180
 AMUSEME_ORIGIN=http://127.0.0.1:4180
 AMUSEME_DATA_DIR=data
+# 127.0.0.1 locally; 0.0.0.0 only behind an HTTPS proxy with an https:// AMUSEME_ORIGIN.
+AMUSEME_HOST=127.0.0.1
+# none locally; modal only behind Modal's HTTPS proxy, so sign-in limits count each client.
+AMUSEME_TRUSTED_PROXY=none
 # Use a private, random secret of at least 32 characters. Never commit its value.
 BETTER_AUTH_SECRET=
 
@@ -13,10 +17,20 @@
 AMUSEME_INVITE_PASSWORD=
 AMUSEME_INVITE_ROLE=user
 
-# Use a separate AmuseMe MinerU service for live processing.
+# Runtime model processing uses Meta only.
 # Keep the same budget ID and data directory across restarts and retries.
 AMUSEME_PROCESSING_ENABLED=false
+AMUSEME_PROCESSING_BUDGET_USD=
+AMUSEME_BUDGET_ID=
+
+# Optional historical remote cleanup only; never used for new extraction.
 AMUSEME_MINERU_URL=
 AMUSEME_MINERU_TOKEN=
-AMUSEME_PROCESSING_BUDGET_USD=
-AMUSEME_BUDGET_ID=
+
+# Judge access (off when unset). Email-only sign-in creates user-role accounts.
+AMUSEME_JUDGE_SIGN_IN=false
+AMUSEME_JUDGE_ACCESS_CODE=
+# User ID whose documents everyone signed in can read but not change.
+AMUSEME_EXAMPLES_OWNER_ID=
+# Lifetime uploads per non-admin user; unset means unlimited.
+AMUSEME_UPLOADS_PER_USER=
